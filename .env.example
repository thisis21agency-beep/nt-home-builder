DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,cms.ruffntumblekids.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://cms.ruffntumblekids.com,https://www.ruffntumblekids.com
RNT_STOREFRONT_ORIGIN=https://www.ruffntumblekids.com

# Preferred on Vercel. Neon/other Postgres integrations normally provide this automatically.
DATABASE_URL=

# Optional legacy split PostgreSQL variables. Used only when DATABASE_URL is blank.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Production admin bootstrap. Store password as a Vercel Secret, not in Git.
RNT_ADMIN_USERNAME=rntadmin
RNT_ADMIN_EMAIL=
RNT_ADMIN_PASSWORD=

# Optional public base URL for uploaded media.
PUBLIC_MEDIA_BASE_URL=

# Optional S3-compatible DigitalOcean Spaces media uploads.
SPACES_BUCKET_NAME=rnt-website
SPACES_REGION=lon1
SPACES_ENDPOINT_URL=https://lon1.digitaloceanspaces.com
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_PUBLIC=0
